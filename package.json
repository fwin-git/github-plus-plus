{
  "name": "github-plus-plus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Github++: documentation search and code/test counts for GitHub.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs --zip",
    "icons": "node icons/gen-icons.mjs",
    "install-ext": "node cli/install.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "media": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "~27.4.0",
    "puppeteer": "^25.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fwin-git/github-plus-plus.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
