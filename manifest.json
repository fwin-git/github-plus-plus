{
  "manifest_version": 3,
  "name": "Github++",
  "version": "0.2.0",
  "description": "Adds GitHub docs and Confluence Cloud reading, plus separate code, test, and draft counts for pull requests.",
  "homepage_url": "https://github.com/fwin-git/github-plus-plus",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": ["https://*.atlassian.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Github++",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-plus-plus@extensions.invalid",
      "strict_min_version": "121.0"
    }
  }
}
